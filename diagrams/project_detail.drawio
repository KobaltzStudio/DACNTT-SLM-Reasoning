point định trước&lt;/b&gt;&lt;br&gt;(báo cáo kết quả cuối)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1440" y="760" width="500" height="55" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b&gt;Chỉ số&lt;/b&gt;&lt;br&gt;accuracy chính thức và lỏng, accuracy theo capability,&lt;br&gt;tỉ lệ đúng định dạng, độ dài output" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1440" y="835" width="500" height="70" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;Tập độ bền (tuỳ chọn, exploratory)&lt;/b&gt;&lt;br&gt;GSM-Plus / GSM-Symbolic" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1440" y="925" width="500" height="55" as="geometry"/></mxCell><mxCell id="c69" value="checkpoint S_t" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;" edge="1" parent="1" source="c47" target="c64"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="605"/><mxPoint x="1410" y="605"/><mxPoint x="1410" y="637"/></Array></mxGeometry></mxCell><mxCell id="c70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c64" target="c65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;fontSize=10;label