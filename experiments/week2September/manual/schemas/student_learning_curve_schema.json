{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Student Capability Learning Dynamics",
  "type": "object",
  "required": [
    "student_id",
    "status",
    "checkpoints",
    "capabilities"
  ],
  "properties": {
    "student_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "synthetic",
        "empirical"
      ]
    },
    "anomaly_threshold": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "checkpoint_id",
          "order"
        ],
        "properties": {
          "checkpoint_id": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "training_step": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability",
          "observations"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "addition",
              "subtraction",
              "multiplication",
              "division",
              "percentage",
              "fraction",
              "ratio"
            ]
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "checkpoint_id",
                "mastery"
              ],
              "properties": {
                "checkpoint_id": {
                  "type": "string"
                },
                "mastery": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "delta": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "state": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "improvement",
                    "regression",
                    "plateau",
                    "sudden_gain",
                    "sudden_drop",
                    null
                  ]
                },
                "is_anomaly": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "overall_mastery": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "checkpoint_id",
          "mastery"
        ],
        "properties": {
          "checkpoint_id": {
            "type": "string"
          },
          "mastery": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}