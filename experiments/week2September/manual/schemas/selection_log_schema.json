{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal 2 Selection Log Record",
  "description": "One JSONL line per record. 'selection' = one scored trajectory at one round (old readme 16.1 Logging). 'checkpoint' = one Student checkpoint (old readme 5.1). Source: git show 3f7dce4^:readme.md.",
  "oneOf": [
    {"$ref": "#/$defs/selection"},
    {"$ref": "#/$defs/checkpoint"}
  ],
  "$defs": {
    "method": {
      "type": "string",
      "enum": ["B0", "B1", "B2", "B3", "B4", "B5", "B6", "ablation_shuffled_scores"]
    },
    "checkpoint_name": {
      "type": "string",
      "pattern": "^student_ckpt_[0-9]{3}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_number": {
      "type": ["number", "null"]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "method",
        "round",
        "source_checkpoint",
        "training_seed",
        "problem_id",
        "trajectory_id",
        "tokens",
        "nll",
        "ell_star",
        "sigma",
        "l_proxy",
        "score",
        "selected",
        "criterion",
        "outcome",
        "config_hash"
      ],
      "properties": {
        "record_type": {"const": "selection"},
        "method": {"$ref": "#/$defs/method"},
        "round": {"type": "integer", "minimum": 0},
        "source_checkpoint": {
          "$ref": "#/$defs/checkpoint_name",
          "description": "Student checkpoint S_t used to score the trajectory."
        },
        "training_seed": {"type": "integer"},
        "problem_id": {
          "type": "string",
          "pattern": "^gsm8k_train_[0-9]{5}$",
          "description": "Must belong to D_pool (checked against splits/d_pool_ids.txt by the validator)."
        },
        "trajectory_id": {"type": "string", "minLength": 1},
        "tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "Training tokens of this trajectory under the Student tokenizer."
        },
        "nll": {
          "$ref": "#/$defs/nullable_number",
          "description": "Length-normalized NLL ell(tau | S_t). Null for methods that do not use it."
        },
        "ell_star": {"$ref": "#/$defs/nullable_number"},
        "sigma": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "l_proxy": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "score": {
          "$ref": "#/$defs/nullable_number",
          "description": "Value actually used for ranking (L_proxy for B4/B5, full score for B6, null for B0-B3)."
        },
        "rank": {"type": ["integer", "null"], "minimum": 1},
        "selected": {"type": "boolean"},
        "criterion": {
          "type": "string",
          "minLength": 1,
          "description": "Why the trajectory was selected or not (e.g. 'top_score', 'n_cap_reached', 'budget_exhausted', 'shortest_correct', 'random')."
        },
        "outcome": {
          "type": ["object", "null"],
          "description": "Filled after training if available; null when the record is written."
        },
        "config_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "checkpoint",
        "parent_checkpoint",
        "round",
        "method",
        "training_seed",
        "data_order_seed",
        "cumulative_training_tokens",
        "cumulative_optimization_steps",
        "selected_trajectory_ids",
        "beta_est_forward_passes",
        "config_hash"
      ],
      "properties": {
        "record_type": {"const": "checkpoint"},
        "checkpoint": {"$ref": "#/$defs/checkpoint_name"},
        "parent_checkpoint": {
          "oneOf": [
            {"$ref": "#/$defs/checkpoint_name"},
            {"type": "null"}
          ]
        },
        "round": {"type": "integer", "minimum": 0},
        "method": {"$ref": "#/$defs/method"},
        "training_seed": {"type": "integer"},
        "data_order_seed": {"type": "integer"},
        "cumulative_training_tokens": {"type": "integer", "minimum": 0},
        "cumulative_optimization_steps": {"type": "integer", "minimum": 0},
        "selected_trajectory_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "beta_est_forward_passes": {
          "type": "integer",
          "minimum": 0,
          "description": "Student forward passes spent on learnability estimation at this checkpoint (old readme 11.1)."
        },
        "config_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
