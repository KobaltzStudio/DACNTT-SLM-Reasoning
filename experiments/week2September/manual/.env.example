# Copy to .env (same folder) and fill in. .env is git-ignored: never commit it.
# Used by scripts/notify_email.py (run_all.sh sends a mail when it ends).
# Gmail: enable 2-step verification, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_FROM defaults to SMTP_USER
MAIL_TO=your.address@gmail.com
