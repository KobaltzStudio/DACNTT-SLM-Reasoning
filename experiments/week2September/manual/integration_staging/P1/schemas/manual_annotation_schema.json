{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GSM8K Manual Capability Annotation",
  "type": "object",
  "required": [
    "problem_id",
    "capabilities_manual",
    "difficulty_manual",
    "notes",
    "annotator_id",
    "schema_version"
  ],
  "properties": {
    "problem_id": {
      "type": "string"
    },
    "capabilities_manual": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "addition",
          "subtraction",
          "multiplication",
          "division",
          "percentage",
          "fraction",
          "ratio"
        ]
      }
    },
    "difficulty_manual": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "notes": {
      "type": "string"
    },
    "annotator_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  }
}