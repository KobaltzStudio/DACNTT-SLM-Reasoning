{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal 2 Experiment Configuration",
  "description": "Structure of config/experiment_config.json. \"TBD\" is allowed in a draft; scripts/validate_experiment_config.py --frozen rejects any remaining \"TBD\".",
  "type": "object",
  "required": [
    "config_version",
    "splits",
    "teacher",
    "student",
    "schedule",
    "budget",
    "training",
    "seeds",
    "learnability",
    "selection",
    "evaluation",
    "methods",
    "analysis"
  ],
  "$defs": {
    "tbd": {"const": "TBD"},
    "int_or_tbd": {"oneOf": [{"type": "integer"}, {"$ref": "#/$defs/tbd"}]},
    "pos_int_or_tbd": {"oneOf": [{"type": "integer", "minimum": 1}, {"$ref": "#/$defs/tbd"}]},
    "str_or_tbd": {"type": "string", "minLength": 1},
    "sha_or_tbd": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"$ref": "#/$defs/tbd"}]},
    "method": {"enum": ["B0", "B1", "B2", "B3", "B4", "B5", "B6", "ablation_shuffled_scores"]}
  },
  "properties": {
    "config_version": {"type": "string", "minLength": 1},
    "splits": {
      "type": "object",
      "required": ["manifest", "manifest_sha256", "split_seed", "n_dev", "near_duplicate_ngram"],
      "properties": {
        "manifest": {"type": "string"},
        "manifest_sha256": {"$ref": "#/$defs/sha_or_tbd"},
        "split_seed": {"type": "integer"},
        "n_dev": {"type": "integer", "minimum": 1},
        "near_duplicate_ngram": {"type": "integer", "minimum": 1}
      }
    },
    "teacher": {
      "type": "object",
      "required": ["model", "revision", "K", "temperature", "max_new_tokens", "generation_seed_base"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "revision": {"$ref": "#/$defs/str_or_tbd"},
        "K": {"type": "integer", "minimum": 1},
        "temperature": {"type": "number", "minimum": 0},
        "max_new_tokens": {"type": "integer", "minimum": 1},
        "generation_seed_base": {"type": "integer"}
      }
    },
    "student": {
      "type": "object",
      "required": ["model", "revision", "initial_checkpoint"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "revision": {"$ref": "#/$defs/str_or_tbd"},
        "initial_checkpoint": {"const": "student_ckpt_000"}
      }
    },
    "schedule": {
      "type": "object",
      "required": ["rounds_M", "checkpoint_name"],
      "properties": {
        "rounds_M": {"type": "integer", "minimum": 1},
        "checkpoint_name": {"type": "string"}
      }
    },
    "budget": {
      "type": "object",
      "required": ["unit", "n_round", "beta_round_tokens", "probe_budget_b_steps", "report_beta_est"],
      "properties": {
        "n_round": {"$ref": "#/$defs/pos_int_or_tbd"},
        "beta_round_tokens": {"$ref": "#/$defs/pos_int_or_tbd"},
        "probe_budget_b_steps": {"$ref": "#/$defs/pos_int_or_tbd"},
        "report_beta_est": {"const": true}
      }
    },
    "training": {
      "type": "object",
      "required": ["method", "learning_rate", "optimizer", "batch_size", "epochs_per_round", "max_seq_len"],
      "properties": {
        "learning_rate": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"$ref": "#/$defs/tbd"}]},
        "batch_size": {"$ref": "#/$defs/pos_int_or_tbd"},
        "epochs_per_round": {"$ref": "#/$defs/pos_int_or_tbd"},
        "max_seq_len": {"$ref": "#/$defs/pos_int_or_tbd"}
      }
    },
    "seeds": {
      "type": "object",
      "required": ["training_seeds", "data_order_seed_rule"],
      "properties": {
        "training_seeds": {"type": "array", "items": {"type": "integer"}, "minItems": 3, "uniqueItems": true}
      }
    },
    "learnability": {
      "type": "object",
      "required": ["proxy", "ell_star_rule", "sigma_rule", "eligible"]
    },
    "selection": {
      "type": "object",
      "required": ["n_cap", "alpha", "retention_r", "retention_scope", "allow_reselect_across_rounds", "tie_break", "b3_rule"],
      "properties": {
        "n_cap": {"type": "integer", "minimum": 1},
        "alpha": {"oneOf": [{"type": "number", "minimum": 0, "exclusiveMaximum": 1}, {"$ref": "#/$defs/tbd"}]},
        "retention_r": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"$ref": "#/$defs/tbd"}]},
        "allow_reselect_across_rounds": {"type": "boolean"}
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["decoding", "max_new_tokens", "prompt_version", "answer_extractor", "answer_verifier", "test_checkpoints"],
      "properties": {
        "decoding": {"const": "greedy"},
        "max_new_tokens": {"type": "integer", "minimum": 1},
        "test_checkpoints": {"type": "array", "items": {"type": "string", "pattern": "^student_ckpt_[0-9]{3}$"}, "minItems": 1}
      }
    },
    "methods": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": {"type": "array", "items": {"$ref": "#/$defs/method"}, "contains": {"const": "B4"}},
        "recommended": {"type": "array", "items": {"$ref": "#/$defs/method"}},
        "optional": {"type": "array", "items": {"$ref": "#/$defs/method"}}
      }
    },
    "analysis": {
      "type": "object",
      "required": ["primary_metric", "primary_comparison", "significance_alpha"],
      "properties": {
        "significance_alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
      }
    }
  }
}
