from pathlib import Path
import csv
import hashlib
import json
import sys

P2 = Path(r"C:\Users\PC - NGHI\Desktop\Pipeline\P2")
MANUAL = P2 / "experiments" / "week2September" / "manual"
AUDIT = P2 / "integration_staging" / "G4_CHECKPOINT_AUDIT"

EXTRACTED = AUDIT / "extracted_checkpoints" / "B4_seed13"
PRED_DIR = MANUAL / "reports" / "p1p2_integration" / "derived_predictions" / "B4_seed13"

CONFIG = MANUAL / "integration_staging" / "P1" / "config" / "experiment_config.json"
EVALUATOR = MANUAL / "scripts" / "capability_eval.py"

GOLD_MANIFEST = MANUAL / "data" / "gold_vfinal" / "gold_vfinal_manifest.json"
GOLD_LABELS = MANUAL / "data" / "gold_vfinal" / "supplement_annotations_vfinal.jsonl"
APPROVAL = MANUAL / "data" / "gold_releases" / "vFinal_2026-11-16" / "gold_supplement_85_approved_review.csv"
DEV_IDS = MANUAL / "splits" / "d_dev_ids.txt"

EXPECTED_CONFIG_SHA256 = "17cf4b837dc42ac5145aea762847ca5dfba4bae58d253560b3b0dd6a254b73c5"

STAGES = {
    "S1": {
        "checkpoint": EXTRACTED / "S1",
        "prediction": PRED_DIR / "eval_student_ckpt_001_dev_status.jsonl",
        "train_set": MANUAL / "runs" / "main" / "B4_seed13" / "round_000" / "train_set.json",
        "expected_train_set_sha256": "614816f15b980f9958dd1747a3c0773171d8112ad167e116b7a7651d9623a006",
        "expected_parent": "student_ckpt_000",
    },
    "S2": {
        "checkpoint": EXTRACTED / "S2",
        "prediction": PRED_DIR / "eval_student_ckpt_002_dev_status.jsonl",
        "train_set": MANUAL / "runs" / "main" / "B4_seed13" / "round_001" / "train_set.json",
        "expected_train_set_sha256": "cb82cb58ed58a92a8fd0dd33b09322e99191ecd048daf63a36b5ea4182898e1a",
        "expected_parent": "student_ckpt_001",
    },
    "S3": {
        "checkpoint": EXTRACTED / "S3",
        "prediction": PRED_DIR / "eval_student_ckpt_003_dev_status.jsonl",
        "train_set": MANUAL / "runs" / "main" / "B4_seed13" / "round_002" / "train_set.json",
        "expected_train_set_sha256": "f16cb78cbdaf4ce5280d79c552adab5ec57f56ca26a3796b02995f0de2441e0e",
        "expected_parent": "student_ckpt_002",
    },
}

OUT_ROOT = MANUAL / "reports" / "capability_g4_validation"

def sha256_file(path):
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()

def load_json(path):
    with path.open("r", encoding="utf-8-sig") as f:
        return json.load(f)

def read_ids(path):
    return [
        line.strip()
        for line in path.read_text(encoding="utf-8-sig").splitlines()
        if line.strip()
    ]

def read_jsonl(path):
    rows = []
    errors = []
    with path.open("r", encoding="utf-8-sig") as f:
        for line_no, line in enumerate(f, 1):
            if not line.strip():
                continue
            try:
                rows.append(json.loads(line))
            except Exception as exc:
                errors.append({
                    "line": line_no,
                    "error": f"{type(exc).__name__}: {exc}",
                })
    return rows, errors

def main():
    checks = []
    report = {
        "stages": {},
        "paths": {},
        "checks": checks,
    }

    def check(name, passed, detail):
        checks.append({
            "name": name,
            "passed": bool(passed),
            "detail": str(detail),
        })
        print(f"{name}={'PASS' if passed else 'FAIL'} | {detail}")

    print("========== G5 CAPABILITY PREFLIGHT ==========")

    # Required top-level files
    required = {
        "capability_eval.py": EVALUATOR,
        "experiment_config.json": CONFIG,
        "gold_vfinal_manifest.json": GOLD_MANIFEST,
        "supplement_annotations_vfinal.jsonl": GOLD_LABELS,
        "gold_supplement_85_approved_review.csv": APPROVAL,
        "d_dev_ids.txt": DEV_IDS,
    }

    for name, path in required.items():
        exists = path.is_file()
        check(f"FILE_{name}", exists, path)

    if not all(path.is_file() for path in required.values()):
        report["status"] = "BLOCKED_MISSING_INPUT"
        write_report(report)
        return 2

    config_hash = sha256_file(CONFIG)
    check(
        "CONFIG_SHA256_MATCH",
        config_hash == EXPECTED_CONFIG_SHA256,
        f"actual={config_hash}; expected={EXPECTED_CONFIG_SHA256}"
    )

    manifest = load_json(GOLD_MANIFEST)
    check(
        "GOLD_VERSION_VFINAL",
        manifest.get("gold_version") == "vFinal",
        manifest.get("gold_version")
    )
    check(
        "GOLD_SUPPLEMENT_COUNT_85",
        manifest.get("supplement_count") == 85,
        manifest.get("supplement_count")
    )

    dev_ids = read_ids(DEV_IDS)
    check(
        "D_DEV_COUNT_500",
        len(dev_ids) == 500 and len(set(dev_ids)) == 500,
        f"rows={len(dev_ids)} unique={len(set(dev_ids))}"
    )

    gold_rows, gold_errors = read_jsonl(GOLD_LABELS)
    check(
        "GOLD_LABELS_85",
        len(gold_rows) == 85 and not gold_errors,
        f"rows={len(gold_rows)} errors={len(gold_errors)}"
    )

    with APPROVAL.open("r", encoding="utf-8-sig", newline="") as f:
        approval_rows = list(csv.DictReader(f))
    check(
        "APPROVAL_ROWS_85",
        len(approval_rows) == 85,
        f"rows={len(approval_rows)}"
    )

    report["paths"] = {
        name: str(path) for name, path in required.items()
    }
    report["config_sha256"] = config_hash
    report["dev_id_count"] = len(dev_ids)
    report["gold_label_count"] = len(gold_rows)
    report["approval_row_count"] = len(approval_rows)

    for stage, spec in STAGES.items():
        print(f"\n========== {stage} ==========")
        stage_result = {}
        report["stages"][stage] = stage_result

        checkpoint = spec["checkpoint"]
        train_set = spec["train_set"]
        prediction = spec["prediction"]

        check(f"{stage}_CHECKPOINT_DIR", checkpoint.is_dir(), checkpoint)

        weights = checkpoint / "adapter_model.safetensors"
        adapter_config = checkpoint / "adapter_config.json"
        train_log_path = checkpoint / "train_log.json"

        check(f"{stage}_WEIGHTS", weights.is_file(), weights)
        check(f"{stage}_ADAPTER_CONFIG", adapter_config.is_file(), adapter_config)
        check(f"{stage}_TRAIN_LOG", train_log_path.is_file(), train_log_path)

        if weights.is_file():
            stage_result["adapter_weights_sha256"] = sha256_file(weights)
            print(f"{stage}_ADAPTER_WEIGHTS_SHA256={stage_result['adapter_weights_sha256']}")

        if not train_log_path.is_file():
            continue

        train_log = load_json(train_log_path)
        actual_parent = train_log.get("checkpoint_parent")
        actual_train_hash = train_log.get("train_set_sha256")
        actual_config_hash = train_log.get("config_sha256")

        check(
            f"{stage}_PARENT_METADATA",
            bool(actual_parent),
            actual_parent
        )
        check(
            f"{stage}_PARENT_EXPECTED",
            spec["expected_parent"] in str(actual_parent),
            f"actual={actual_parent}; expected_contains={spec['expected_parent']}"
        )

        check(
            f"{stage}_TRAIN_SET_EXISTS",
            train_set.is_file(),
            train_set
        )

        if train_set.is_file():
            actual_file_hash = sha256_file(train_set)
            train_hash_ok = (
                actual_file_hash == spec["expected_train_set_sha256"]
                and actual_train_hash == spec["expected_train_set_sha256"]
            )
            check(
                f"{stage}_TRAIN_SET_HASH",
                train_hash_ok,
                f"file={actual_file_hash}; log={actual_train_hash}"
            )
            stage_result["train_set_sha256"] = actual_file_hash

        check(
            f"{stage}_CONFIG_HASH",
            actual_config_hash == EXPECTED_CONFIG_SHA256,
            actual_config_hash
        )

        rows, errors = read_jsonl(prediction) if prediction.is_file() else ([], ["FILE_NOT_FOUND"])
        ids = [str(row.get("problem_id", "")) for row in rows]
        coverage_ok = (
            prediction.is_file()
            and not errors
            and len(rows) == 500
            and len(set(ids)) == 500
            and set(ids) == set(dev_ids)
        )
        check(
            f"{stage}_PREDICTION_COVERAGE",
            coverage_ok,
            f"exists={prediction.is_file()} rows={len(rows)} unique={len(set(ids))} errors={len(errors)}"
        )

        stage_result.update({
            "checkpoint": str(checkpoint),
            "prediction": str(prediction),
            "train_set": str(train_set),
            "parent": actual_parent,
            "train_set_hash_from_log": actual_train_hash,
            "config_hash_from_log": actual_config_hash,
            "prediction_rows": len(rows),
            "prediction_unique_ids": len(set(ids)),
            "prediction_errors": errors,
        })

    out_root_safe = not OUT_ROOT.exists()
    check("OUTPUT_ROOT_NOT_EXISTS", out_root_safe, OUT_ROOT)

    all_pass = all(item["passed"] for item in checks)
    report["status"] = "PASS" if all_pass else "BLOCKED"
    report["all_checks_pass"] = all_pass
    report["output_root"] = str(OUT_ROOT)

    write_report(report)

    print("\n========== PREFLIGHT SUMMARY ==========")
    print(f"CHECK_COUNT={len(checks)}")
    print(f"FAILED_CHECKS={sum(not x['passed'] for x in checks)}")
    print(f"PREFLIGHT_STATUS={report['status']}")
    print(f"REPORT={AUDIT / 'g5_capability_preflight.json'}")

    return 0 if all_pass else 2

def write_report(report):
    output = AUDIT / "g5_capability_preflight.json"
    output.write_text(
        json.dumps(report, indent=2, ensure_ascii=False),
        encoding="utf-8"
    )

if __name__ == "__main__":
    sys.exit(main())
