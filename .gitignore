# ============================================================
# Python
# ============================================================

.venv/
venv/
env/

__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/

.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# Environment / Secrets
# ============================================================

.env
.env.*
!.env.example

*.pem
*.key

# ============================================================
# Models / Model Weights
# ============================================================

# Ignore model files inside the models directory
models/*
!models/README.md
!models/.gitkeep

# Common model weight formats
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf

# ============================================================
# Hugging Face / ML Cache
# ============================================================

.cache/
hf_cache/
huggingface/
checkpoints/

# Hugging Face cache may also exist under the user directory,
# but this rule protects any project-local cache.

# ============================================================
# Datasets
# ============================================================

# Do not commit actual datasets
datasets/*
!datasets/README.md
!datasets/.gitkeep

# Common dataset/archive formats
*.arrow
*.parquet
*.feather

# ============================================================
# Experiment Outputs
# ============================================================

# Ignore generated outputs by default
outputs/*
!outputs/README.md
!outputs/.gitkeep

# Keep small research result files
!outputs/*.json
!outputs/*.jsonl
!outputs/*.csv
!outputs/*.md

# Ignore large/generated experiment artifacts
outputs/**/*.pt
outputs/**/*.pth
outputs/**/*.bin
outputs/**/*.safetensors
outputs/**/*.gguf
outputs/**/checkpoints/
outputs/**/models/

# ============================================================
# Logs
# ============================================================

*.log

# ============================================================
# IDE
# ============================================================

.vscode/
.idea/

# ============================================================
# Operating System
# ============================================================

.DS_Store
Thumbs.db
desktop.ini*.bkp
